    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst rows = $input.all().map(function (i) { return i.json; });\nlet orders = [];\nrows.forEach(function (j) {\n  if (Array.isArray(j.orders)) orders = orders.concat(j.orders);\n  else if (Array.isArray(j.results)) orders = orders.concat(j.results);\n  else if (Array.isArray(j.items)) orders = orders.concat(j.items);\n  else if (Array.isArray(j.data)) orders = orders.concat(j.data);\n  else if (j.id !== undefined) orders.push(j);\n});\n\nconst seen = store.seenOrderIds || [];\nconst firstRun = !store.initialized;\nconst fresh = orders.filter(function (o) { return seen.indexOf(String(o.id)) === -1; });\n\nstore.seenOrderIds = seen.concat(fresh.map(function (o) { return String(o.id); })).slice(-500);\nstore.initialized = true;\n\nif (firstRun) return [];\n\nreturn fresh.map(function (o) {\n  return { json: { orderId: String(o.id), createdDate: o.createdDate } };\n});"
      },
